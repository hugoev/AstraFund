# AstraFund Environment Variables

# Gemini AI API Key (Get your free API key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./astrafund.db

# Application Settings
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_TITLE=AstraFund API
API_VERSION=1.0.0
API_DESCRIPTION=Financial Compliance Co-Pilot for Non-Profits

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
